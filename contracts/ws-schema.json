      "required": [
        "type",
        "order_id",
        "status",
        "price",
        "reason"
      ],
      "title": "FillMessage",
      "type": "object"
    },
    "NewsItem": {
      "properties": {
        "headline": {
          "title": "Headline",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "integer"
        },
        "published_at": {
          "format": "date-time",
          "title": "Published At",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "id",
        "source",
        "headline",
        "summary",
        "url",
        "published_at"
      ],
      "title": "NewsItem",
      "type": "object"
    },
    "NewsMessage": {
      "properties": {
        "item": {
          "$ref": "#/$defs/NewsItem"
        },
        "type": {
          "const": "news",
          "default": "news",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "item"
      ],
      "title": "NewsMessage",
      "type": "object"
    },
