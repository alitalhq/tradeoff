      "required": [
        "type",
        "period_no",
        "starts_at",
        "ends_at",
        "awaiting_limits"
      ],
      "title": "PeriodMessage",
      "type": "object"
    }
  },
  "discriminator": {
    "mapping": {
      "bar": "#/$defs/BarMessage",
      "clock": "#/$defs/ClockMessage",
      "fill": "#/$defs/FillMessage",
      "news": "#/$defs/NewsMessage",
      "period": "#/$defs/PeriodMessage"
    },
    "propertyName": "type"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/ClockMessage"
    },
    {
      "$ref": "#/$defs/BarMessage"
    },
    {
      "$ref": "#/$defs/NewsMessage"
    },
    {
      "$ref": "#/$defs/FillMessage"
    },
    {
      "$ref": "#/$defs/PeriodMessage"
    }
  ]
}
