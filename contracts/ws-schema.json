        "asset_id": {
          "title": "Asset Id",
          "type": "integer"
        },
        "bar_end": {
          "format": "date-time",
          "title": "Bar End",
          "type": "string"
        },
        "bar_start": {
          "format": "date-time",
          "title": "Bar Start",
          "type": "string"
        },
        "close": {
          "title": "Close",
          "type": "string"
        },
        "high": {
          "title": "High",
          "type": "string"
        },
        "low": {
          "title": "Low",
          "type": "string"
        },
        "open": {
          "title": "Open",
          "type": "string"
        },
        "timeframe": {
          "title": "Timeframe",
          "type": "string"
        },
        "volume": {
          "title": "Volume",
          "type": "integer"
        }
      },
      "required": [
        "asset_id",
        "timeframe",
        "bar_start",
        "bar_end",
        "open",
        "high",
        "low",
        "close",
        "volume"
      ],
      "title": "Bar",
      "type": "object"
    },
    "BarMessage": {
      "properties": {
        "asset_id": {
          "title": "Asset Id",
          "type": "integer"
        },
        "bar": {
          "$ref": "#/$defs/Bar"
        },
        "type": {
          "const": "bar",
          "default": "bar",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "asset_id",
        "bar"
      ],
      "title": "BarMessage",
      "type": "object"
    },
    "ClockMessage": {
      "properties": {
        "sim_time": {
          "format": "date-time",
          "title": "Sim Time",
          "type": "string"
        },
        "status": {
          "enum": [
            "created",
            "running",
            "paused",
            "finished"
          ],
          "title": "Status",
          "type": "string"
        },
        "type": {
          "const": "clock",
          "default": "clock",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "sim_time",
        "status"
      ],
      "title": "ClockMessage",
      "type": "object"
    },
    "FillMessage": {
      "properties": {
        "order_id": {
          "title": "Order Id",
          "type": "integer"
        },
        "price": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Price"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason"
        },
        "status": {
          "enum": [
            "filled",
            "rejected"
          ],
          "title": "Status",
          "type": "string"
        },
        "type": {
          "const": "fill",
          "default": "fill",
          "title": "Type",
          "type": "string"
        }
