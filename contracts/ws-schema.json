          "format": "date-time",
          "title": "Ends At",
          "type": "string"
        },
        "period_no": {
          "title": "Period No",
          "type": "integer"
        },
        "starts_at": {
          "format": "date-time",
          "title": "Starts At",
          "type": "string"
        },
        "type": {
          "const": "period",
          "default": "period",
          "title": "Type",
          "type": "string"
        }
